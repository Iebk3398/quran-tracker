{
  "name": "@quran-tracker/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env --experimental-strip-types --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.1",
    "@quran-tracker/db": "*",
    "@quran-tracker/types": "*",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "better-auth": "^1.2.5",
    "dotenv": "^17.3.1",
    "hono": "^4.6.14",
    "nanoid": "^5.0.9",
    "resend": "^4.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "*"
  }
}
